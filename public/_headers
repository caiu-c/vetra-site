# Cabeçalhos HTTP do Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# JS, CSS e fontes gerados pelo Vite têm hash no nome: cache imutável de 1 ano.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
