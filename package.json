    "fontkit": "^2.0.4",
    "globals": "^17.6.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.2",
    "wawoff2": "^2.0.1"
  },
  "packageManager": "pnpm@10.33.2"
