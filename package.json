{
  "name": "vetra-solutions-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Site institucional Vetra Solutions",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx,.jsx,.astro",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,astro,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,jsx,astro,md,json,css}\"",
    "gen:og": "node scripts/generate-og.mjs",
    "gen:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^4.16.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^3.4.19",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.39.4",
    "@resvg/resvg-js": "^2.6.2",
