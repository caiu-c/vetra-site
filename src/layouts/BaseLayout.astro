---
import '@fontsource-variable/archivo/wdth.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Cursor from '@/components/Cursor.astro';
import { SITE, ADDRESS, CONTACT, CONTACT_FORM_ANCHOR, HOME_CONTACT_URL } from '@/config/site';
import BookingDialog from '@/components/BookingDialog.astro';
import StickyCta from '@/components/StickyCta.astro';

interface Props {
  title?: string;
  description?: string;
  /** Páginas que não devem ir para o índice (ex.: 404). */
  noindex?: boolean;
  /** false em páginas sem o formulário de contato: os CTAs do layout levam ao da home. */
  contactOnPage?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  contactOnPage = true,
} = Astro.props;
const contactHref = contactOnPage ? CONTACT_FORM_ANCHOR : HOME_CONTACT_URL;

// URL canônica autorreferente (uma só versão indexável; o www redireciona no painel).
const canonical = new URL(Astro.url.pathname, SITE.url).href;

/* JSON-LD Organization (schema.org) — campos TODO ficam visíveis no source para
   sinalizar pendências antes do go-live: telephone (formato E.164), email,
   address (streetAddress + postalCode reais), sameAs (URLs validadas). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  foundingDate: String(SITE.founded),
  // TODO: confirmar email institucional antes do go-live
  email: CONTACT.email,
  // TODO: adicionar telefone real em formato E.164 (+55 85 ...)
  telephone: 'TODO',
  // TODO: validar URLs de redes sociais antes do go-live
  sameAs: [CONTACT.linkedin],
  taxID: CONTACT.cnpj,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS.streetAddress,
    addressLocality: ADDRESS.addressLocality,
    addressRegion: ADDRESS.addressRegion,
    postalCode: ADDRESS.postalCode,
    addressCountry: ADDRESS.addressCountry,
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    {
      /* Fonte do texto em preload: o topo pinta no primeiro quadro (sem preloader) e a troca
        tardia da fonte reserva deslocava o layout. */
    }
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#FFFFFF" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.title} />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og-image.png`} />

    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Cursor />
    <Header contactHref={contactHref} />
    <main>
      <slot />
    </main>
    <Footer contactHref={contactHref} />
    <StickyCta />
    <BookingDialog />

    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
