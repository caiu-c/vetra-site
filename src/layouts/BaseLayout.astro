---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PanelRuler from '@/components/PanelRuler.astro';
import { SITE, ADDRESS, CONTACT } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

/* JSON-LD Organization (schema.org) — campos TODO ficam visíveis no source para
   sinalizar pendências antes do go-live: telephone (formato E.164), email,
   address (streetAddress + postalCode reais), sameAs (URLs validadas). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  foundingDate: String(SITE.founded),
  // TODO: confirmar email institucional antes do go-live
  email: CONTACT.email,
  // TODO: adicionar telefone real em formato E.164 (+55 85 ...)
  telephone: 'TODO',
  // TODO: validar URLs de redes sociais antes do go-live
  sameAs: [CONTACT.linkedin],
  taxID: CONTACT.cnpj,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS.streetAddress,
    addressLocality: ADDRESS.addressLocality,
    addressRegion: ADDRESS.addressRegion,
    postalCode: ADDRESS.postalCode,
    addressCountry: ADDRESS.addressCountry,
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/fonts/instrument-serif-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-tight-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    {/*
      Estrutura de duas camadas (PRD §4.3 + ADR-002):
      body bg-paper → container 1280 → painel 1100 bg-canvas com moldura 1px rule.
      Header e seções claras vivem dentro do painel; Methodology também (full-width).
      Footer fica FORA do painel, ancorado ao paper, espelhando o mockup que termina em Methodology.
    */}
    <div class="mx-auto max-w-[1280px] px-6 pt-8 pb-8 sm:pt-12 sm:pb-12 md:px-16 md:pt-[50px] md:pb-[50px]">
      <div class="relative mx-auto max-w-[1100px] border border-rule bg-canvas">
        <PanelRuler />
        <Header />
        <main>
          <slot />
        </main>
      </div>
    </div>

    <Footer />

    {/* Lenis precisa rodar antes do IntersectionObserver: ordem no <script> garante isso */}
    <script>
      import '@/scripts/smooth-scroll';
      import '@/scripts/reveal';
    </script>
  </body>
</html>
