---
/*
  Símbolo aperture com uma peça em destaque: cada serviço é uma das 4 peças
  (coordenadas de ApertureSymbol.astro; do chevron externo ao ponto de convergência).
  Mesmo mapeamento da vista explodida da lente 3D. Usado nos cards da home e no topo
  das páginas de serviço.
*/
interface Props {
  /** Índice da peça em destaque (0–3, na ordem de SERVICES). */
  active: number;
  size?: number;
  /** Fundo claro (padrão) ou Tinta: no escuro, peça em brand-light e o resto em line-deep. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { active, size = 40, tone = 'light', class: className } = Astro.props;
const on = tone === 'dark' ? '#6A8CF7' : '#1640D6';
const off = tone === 'dark' ? '#3A4A78' : '#DCE1EA';

const pieces = [
  { kind: 'path', d: 'M8 10 L28 46 L48 10' },
  { kind: 'path', d: 'M14 10 L28 38 L42 10' },
  { kind: 'path', d: 'M20 10 L28 30 L36 10' },
  { kind: 'dot' },
] as const;
---

<svg
  viewBox="0 0 56 56"
  width={size}
  height={size}
  fill="none"
  class:list={['shrink-0', className]}
  aria-hidden="true"
>
  {
    pieces.map((p, k) =>
      p.kind === 'path' ? (
        <path
          d={p.d}
          stroke={k === active ? on : off}
          stroke-width={k === active ? 2.4 : 1.6}
          stroke-linecap="square"
        />
      ) : (
        <circle cx="28" cy="46" r={k === active ? 3.4 : 2.2} fill={k === active ? on : off} />
      ),
    )
  }
</svg>
