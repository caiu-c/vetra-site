---
import { NAV, BOOKING_URL } from '@/config/site';
import ApertureSymbol from './ApertureSymbol.astro';

interface Props {
  /** Destino dos CTAs de contato (âncora local ou o formulário da home). */
  contactHref?: string;
}

const { contactHref = BOOKING_URL } = Astro.props;
---

<dialog
  id="mobile-menu"
  class="m-0 h-full max-h-screen w-full max-w-full bg-canvas text-ink backdrop:bg-ink/40"
  aria-label="Menu de navegação"
>
  <div class="flex h-full flex-col px-6 pb-8">
    <div class="flex h-16 items-center justify-between border-b border-line">
      <div class="flex items-center gap-2.5 text-ink">
        <ApertureSymbol size={24} ariaLabel="" class="text-brand" />
        <span class="font-expanded text-body font-semibold tracking-heading">Vetra Solutions</span>
      </div>
      <button
        type="button"
        data-action="close-menu"
        class="btn-secondary btn-sm"
        aria-label="Fechar menu"
      >
        Fechar
      </button>
    </div>

    <nav class="mt-4 flex flex-col" aria-label="Navegação mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            data-action="close-menu"
            class="font-expanded border-b border-line py-4 text-h4 font-medium tracking-heading"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-auto flex flex-col gap-3">
      <a
        href={contactHref}
        data-action="close-menu"
        data-subject="diagnostico"
        class="btn-primary w-full"
      >
        Agendar diagnóstico
      </a>
      <a href={contactHref} data-action="close-menu" class="btn-secondary w-full">Contato</a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  if (dialog) {
    document.querySelectorAll('[data-action="open-menu"]').forEach((el) => {
      el.addEventListener('click', () => dialog.showModal());
    });
    dialog.querySelectorAll('[data-action="close-menu"]').forEach((el) => {
      el.addEventListener('click', () => dialog.close());
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
