---
import SectionHeader from './SectionHeader.astro';

const phases = [
  { title: 'Diagnóstico', desc: 'Mapa do sistema, gargalos.' },
  { title: 'Fundação', desc: 'Arquitetura e implantação.' },
  { title: 'Operação', desc: 'Monitoramento e SLA.' },
] as const;
---

{/* Bloco em Tinta no ritmo de cores (ADR-006). As fases são uma sequência real,
    por isso levam numeração. */}
<section id="metodologia" class="relative overflow-hidden bg-ink text-white">
  <div class="wrap py-24 md:py-32">
    <SectionHeader
      title="Não entregamos código — entregamos estrutura."
      description="Cada projeto começa com diagnóstico técnico, segue para fundação arquitetural, e só então vira operação."
      variant="deep"
    />

    <ol class="mt-16 grid grid-cols-1 border-t border-line-deep md:grid-cols-3">
      {
        phases.map(({ title, desc }, i) => (
          <li
            class:list={[
              'flex flex-col gap-10 py-8 md:gap-14 md:py-10',
              i > 0 && 'border-t border-line-deep md:border-l md:border-t-0 md:pl-10',
              i < 2 && 'md:pr-10',
            ]}
          >
            <span class="numerals-tabular font-expanded text-h3 font-medium text-on-deep-muted">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="flex flex-col gap-2">
              <h3 class="font-expanded text-h3 font-semibold tracking-heading">{title}</h3>
              <p class="text-body text-on-deep-muted">{desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
