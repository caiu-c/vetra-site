---
import SectionHeader from './SectionHeader.astro';

/* Fora da home até ter respostas reais (auditoria A8): publicar "A definir" frustra
   justamente quem já está interessado. Para voltar, importar em src/pages/index.astro.
   TODO: escrever as respostas com o time antes do go-live. As perguntas seguem os
   temas recorrentes nos FAQs de consultorias do setor (segurança, prazo, contratação,
   tecnologia, time) e também podem ser ajustadas. */
const faqs = [
  'Como vocês tratam a segurança e a privacidade dos nossos dados?',
  'Quanto tempo leva um projeto, do diagnóstico à operação?',
  'Como funciona a contratação: projeto fechado ou alocação de time?',
  'Vocês trabalham com as ferramentas que já usamos?',
  'Quem vai trabalhar no nosso projeto?',
] as const;
---

<section id="perguntas" class="bg-surface">
  <div class="wrap">
    <div
      class="grid grid-cols-1 gap-10 py-24 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-16 md:py-32"
    >
      <SectionHeader title="Perguntas frequentes." />

      <div class="border-t border-line">
        {
          faqs.map((q) => (
            <details class="faq group border-b border-line">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-h4 font-medium text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand [&::-webkit-details-marker]:hidden">
                {q}
                <span
                  class="relative mt-2 h-3 w-3 shrink-0 before:absolute before:left-0 before:top-1/2 before:h-px before:w-3 before:bg-ink after:absolute after:left-1/2 after:top-0 after:h-3 after:w-px after:bg-ink after:transition-transform after:duration-300 group-open:after:scale-y-0"
                  aria-hidden="true"
                />
              </summary>
              <p class="max-w-measure pb-6 text-body text-muted">A definir.</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
