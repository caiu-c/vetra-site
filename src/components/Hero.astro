---
import { BOOKING_URL } from '@/config/site';

// TODO: validar texto (auditoria A4: serviço + público no título; consultoria e local no subtítulo).
const title = 'Engenharia de dados para quem ainda decide por planilha.';
// Palavras em spans para a entrada mascarada em CSS (global.css → .hero-word).
const words = title.split(' ');
---

<section class="relative overflow-hidden bg-canvas">
  <div
    class="wrap relative flex min-h-[100svh] flex-col justify-center gap-10 pb-20 pt-32 md:pb-24 md:pt-36"
  >
    {/*
      Âncora da lente 3D (ADR-007): o canvas WebGL desenha a lente aqui.
      O SVG é o fallback estático — sem WebGL ou antes da cena carregar.
    */}
    <div
      data-lens-anchor
      class="pointer-events-none absolute right-[-30%] top-1/2 aspect-square w-[90%] -translate-y-1/2 opacity-40 sm:right-[-12%] sm:w-[60%] sm:opacity-100 md:right-[2%] md:w-[44%] xl:w-[40%]"
      aria-hidden="true"
    >
      <svg data-lens-fallback viewBox="0 0 400 400" class="h-full w-full" fill="none">
        <circle cx="200" cy="200" r="190" fill="#F2F4F8" />
        <circle cx="200" cy="200" r="190" stroke="#DCE1EA" />
        <circle cx="200" cy="200" r="150" stroke="#DCE1EA" stroke-dasharray="2 6" />
        <path d="M10 200H390M200 10V390" stroke="#DCE1EA" />
        <g transform="translate(26 26) scale(0.87)" stroke="#0C1838" stroke-width="10" stroke-linejoin="miter" stroke-linecap="square">
          <path d="M57 71 L200 329 L343 71" />
          <path d="M100 71 L200 271 L300 71" />
          <path d="M143 71 L200 214 L257 71" />
          <circle cx="200" cy="329" r="16" fill="#1640D6" stroke="none" />
        </g>
      </svg>
      {/* Lente 3D (src/scripts/three/lens.ts) — substitui o SVG quando o primeiro quadro sai */}
      <canvas data-lens-canvas class="absolute inset-0 h-full w-full"></canvas>
    </div>

    <h1 class="font-expanded text-balance relative z-10 max-w-[16ch] text-display font-semibold tracking-display text-ink">
      {
        words.map((word, i) => (
          <>
            <span class="hero-word">
              <span style={`--i:${i}`}>{word}</span>
            </span>
            {i < words.length - 1 && ' '}
          </>
        ))
      }
    </h1>

    <p class="hero-fade text-pretty relative z-10 max-w-measure text-lead text-muted">
      Somos uma consultoria de Fortaleza que atende empresas de todo o Brasil. Organizamos
      seus dados em uma base única, entregamos os indicadores prontos e colocamos IA para
      trabalhar com supervisão.
    </p>

    <div class="hero-fade relative z-10 flex flex-col gap-3 sm:flex-row">
      <a href={BOOKING_URL} class="btn-primary" data-subject="diagnostico" data-magnetic>
        Agendar diagnóstico
      </a>
      <a href="#metodologia" class="btn-secondary" data-magnetic>Ver como trabalhamos</a>
    </div>

    <a
      href="#stack"
      class="absolute bottom-8 left-6 hidden h-12 w-px overflow-hidden bg-line md:left-10 md:block xl:left-16"
      aria-label="Rolar para o conteúdo"
    >
      <span class="scroll-cue absolute inset-0 bg-ink"></span>
    </a>
  </div>
</section>
