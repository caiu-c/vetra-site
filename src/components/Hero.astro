---
import { BOOKING_URL } from '@/config/site';
import Stats from './Stats.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import ApertureWatermark from './ApertureWatermark.astro';
---

{/*
  border-b border-rule fecha o Hero e separa visualmente do bloco Capabilities,
  espelhando a <line y=660> do mockup dentro do painel.
  Position relative + overflow-hidden para ancorar HeroBackdrop (nodes, direita)
  e ApertureWatermark (V, esquerda) como backgrounds.
*/}
<section
  class="relative grid gap-16 overflow-hidden border-b border-rule px-6 py-20 md:grid-cols-[1fr_auto] md:gap-24 md:px-12 md:py-28"
>
  <ApertureWatermark position="left" size={700} opacity={0.05} />
  <HeroBackdrop />

  <div class="relative z-10 flex flex-col gap-8">
    <p
      class="stagger stagger-1 font-mono text-[11px] uppercase tracking-[0.24em] text-accent"
    >
      ↳ ENGENHARIA DE DADOS &amp; IA
    </p>

    <h1 class="tracking-display font-serif text-[clamp(40px,7vw,76px)] leading-[0.98] text-ink">
      <span class="stagger stagger-2 block">A coluna</span>
      <span class="stagger stagger-3 block">vertebral dos</span>
      <span class="stagger stagger-4 block italic">seus dados.</span>
    </h1>

    <p
      class="stagger stagger-5 max-w-[560px] font-sans text-[17px] leading-relaxed text-muted"
    >
      Construímos sistemas de dados, agentes de IA e automações com rigor de
      engenharia. Resultado de negócio sustentado por arquitetura técnica.
    </p>

    <div class="stagger stagger-6 flex flex-col gap-4 sm:flex-row sm:gap-4">
      <a
        href={BOOKING_URL}
        class="inline-flex h-[46px] w-[240px] items-center justify-center gap-1 bg-ink font-mono text-[12px] uppercase tracking-[0.18em] text-canvas transition-[transform,background-color] duration-150 hover:scale-[1.02] hover:bg-accent motion-reduce:hover:scale-100"
      >
        <span>AGENDAR DIAGNÓSTICO</span>
        <span class="text-azure" aria-hidden="true">↗</span>
      </a>
      <a
        href="#metodologia"
        class="inline-flex h-[46px] w-[200px] items-center justify-center border border-ink font-mono text-[12px] uppercase tracking-[0.18em] text-ink transition-[transform,background-color,color] duration-150 hover:scale-[1.02] hover:bg-ink hover:text-canvas motion-reduce:hover:scale-100"
      >
        VER METODOLOGIA
      </a>
    </div>
  </div>

  <aside class="relative z-10 md:self-end md:pb-2">
    <Stats />
  </aside>
</section>
