---
interface Props {
  number: string;
  name: string;
  counterpart?: string;
  variant?: 'light' | 'dark';
}

const { number, name, counterpart, variant = 'light' } = Astro.props;
const tone = variant === 'dark' ? 'text-muted-on-dark' : 'text-muted';
---

<div
  class:list={[
    'flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.24em]',
    tone,
  ]}
>
  <span>{number} · {name}</span>
  {counterpart && <span>{counterpart}</span>}
</div>
