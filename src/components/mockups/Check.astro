---
/* Marca de concluído das telas ilustrativas. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  width="16"
  height="16"
  class:list={['shrink-0', className]}
  aria-hidden="true"
>
  <circle cx="8" cy="8" r="8" fill="#1640D6"></circle>
  <path
    d="M4.5 8.2l2.2 2.2 4.8-4.8"
    fill="none"
    stroke="#fff"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
