---
/*
  O que acontece depois do clique (auditoria de conversão C8). Sequência real, por isso
  numerada. Prazos definidos pelo dono em 2026-10-11 (resposta em 1 dia útil, mapa em
  até 5 dias úteis).
*/
const steps = [
  'Você agenda um horário ou escreve',
  'Respondemos em até 1 dia útil',
  'Conversa de 30 min por vídeo',
  'Mapa por escrito em até 5 dias úteis',
] as const;
---

<ol class="flex flex-col gap-3" aria-label="O que acontece depois">
  {
    steps.map((step, i) => (
      <li class="flex items-center gap-3 text-body text-white">
        <span class="numerals-tabular flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/25 text-meta text-brand-light">
          {i + 1}
        </span>
        {step}
      </li>
    ))
  }
</ol>
