---
import { SITE } from '@/config/site';
import ApertureSymbol from './ApertureSymbol.astro';
---

{/* Controlado por src/scripts/motion/preloader.ts; visibilidade inicial via classes do <head>. */}
<div
  id="preloader"
  class="fixed inset-0 z-[100] flex-col justify-between bg-canvas px-6 py-6 text-ink md:px-12 md:py-10"
  aria-hidden="true"
>
  <div class="flex items-center gap-2.5" data-preloader-fade>
    <ApertureSymbol size={24} ariaLabel="" class="text-brand" />
    <span class="font-expanded text-body font-semibold tracking-heading">{SITE.name}</span>
  </div>

  <div class="flex items-end justify-between gap-6">
    <p class="max-w-[16rem] text-meta text-muted" data-preloader-fade>
      Engenharia de dados e IA em {SITE.city}
    </p>
    <span
      class="numerals-tabular font-expanded text-[clamp(60px,9vw,120px)] font-semibold leading-none tracking-display"
      data-preloader-count
      data-preloader-fade>000</span
    >
  </div>

  <div class="absolute inset-x-0 bottom-0 h-[2px] bg-line">
    <div class="preloader-bar h-full bg-brand" data-preloader-bar></div>
  </div>
</div>
