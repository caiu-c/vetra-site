---
// TODO: validar com cliente — números são placeholders
const stats = [
  { label: 'PROJETOS', value: '47+' },
  { label: 'UPTIME', value: '99.97%' },
  { label: 'ANOS', value: '04' },
] as const;
---

{/*
  Layout horizontal em todos os breakpoints: o mockup posiciona os 3 stats lado a lado
  no rail direito do Hero, alinhados verticalmente com os CTAs. Em mobile, descem juntos
  para baixo dos CTAs mantendo a horizontalidade (não vira coluna vertical).
*/}
<dl class="flex flex-row flex-wrap gap-x-8 gap-y-4 md:gap-x-10">
  {
    stats.map(({ label, value }) => (
      <div class="flex flex-col gap-1">
        <dt class="font-mono text-[9px] uppercase tracking-[0.24em] text-muted">
          {label}
        </dt>
        <dd class="numerals-tabular font-serif text-[28px] leading-none text-ink">{value}</dd>
      </div>
    ))
  }
</dl>
