---
// TODO: validar com cliente — números são placeholders
const stats = [
  { label: 'PROJETOS', value: '47+' },
  { label: 'UPTIME', value: '99.97%' },
  { label: 'ANOS', value: '04' },
] as const;
---

<dl class="flex flex-row gap-10 md:flex-col md:gap-8">
  {
    stats.map(({ label, value }) => (
      <div class="flex flex-col gap-1">
        <dt class="font-mono text-[9px] uppercase tracking-[0.24em] text-muted">
          {label}
        </dt>
        <dd class="font-serif text-[28px] leading-none text-ink">{value}</dd>
      </div>
    ))
  }
</dl>
