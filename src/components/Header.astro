---
import { NAV, BOOKING_URL, SITE } from '@/config/site';
import MobileMenu from './MobileMenu.astro';
import ApertureSymbol from './ApertureSymbol.astro';

interface Props {
  /** Destino dos CTAs de contato (âncora local ou o formulário da home). */
  contactHref?: string;
}

const { contactHref = BOOKING_URL } = Astro.props;
---

{/*
  Barra flutuante fixa (referência Genux): afastada das bordas, sempre visível sobre o
  conteúdo. A altura total ocupada (top + barra, 88px) é o scroll-padding-top do
  global.css e o padding-top do hero — manter em sincronia. Fundo sólido e sem
  backdrop-blur: com transparência o texto de trás aparecia em fantasma (auditoria
  A19), e o blur custa caro a cada quadro de scroll.
*/}
<header class="fixed inset-x-3 top-3 z-40 md:inset-x-4 md:top-4">
  <div
    class="mx-auto flex h-16 max-w-[1600px] items-center justify-between rounded-2xl bg-ink pl-5 pr-3 text-white ring-1 ring-white/10 md:pl-7"
  >
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-2.5" aria-label={SITE.name}>
        <ApertureSymbol size={26} ariaLabel="" class="text-brand-light" />
        <span class="font-expanded text-body font-semibold tracking-heading">Vetra Solutions</span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegação principal">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class="rounded-full px-3 py-1.5 text-meta text-white/70 transition-colors hover:text-white"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <a href={contactHref} class="btn-outline-inverse btn-sm hidden lg:inline-flex">Contato</a>
      <a
        href={contactHref}
        class="btn-inverse btn-sm hidden md:inline-flex"
        data-subject="diagnostico"
        data-magnetic="0.25"
      >
        Agendar diagnóstico
      </a>
      <button
        type="button"
        class="btn-outline-inverse btn-sm lg:hidden"
        aria-label="Abrir menu"
        data-action="open-menu"
      >
        Menu
      </button>
    </div>
  </div>
</header>

<MobileMenu contactHref={contactHref} />
