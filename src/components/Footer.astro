---
import { NAV, SITE, CONTACT, BOOKING_URL } from '@/config/site';
import ApertureSymbol from './ApertureSymbol.astro';
const year = new Date().getFullYear();

interface Props {
  /** Destino dos CTAs de contato (âncora local ou o formulário da home). */
  contactHref?: string;
}

const { contactHref = BOOKING_URL } = Astro.props;
---

{/* Continua o bloco Tinta do Contato, separado por uma linha. */}
<footer class="bg-ink text-white">
  <div class="wrap">
    <div class="grid grid-cols-2 gap-10 border-t border-line-deep py-16 md:grid-cols-[2fr_1fr_1fr]">
      <div class="col-span-2 flex flex-col gap-4 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <ApertureSymbol size={24} ariaLabel="" class="text-brand-light" />
          <span class="font-expanded text-body font-semibold tracking-heading">{SITE.name}</span>
        </div>
        <p class="max-w-[22rem] text-meta text-on-deep-muted">
          Engenharia de Dados e IA com rigor institucional. {SITE.city}, Brasil.
        </p>
      </div>

      <nav class="flex flex-col gap-3" aria-label="Navegação rodapé">
        <p class="text-meta font-medium">Empresa</p>
        {
          NAV.map((item) => (
            <a href={item.href} class="text-meta text-on-deep-muted transition-colors hover:text-white">
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-col gap-3">
        <p class="text-meta font-medium">Contato</p>
        <a
          href={contactHref}
          class="text-meta text-on-deep-muted transition-colors hover:text-white"
          data-subject="diagnostico"
        >
          Agendar diagnóstico gratuito
        </a>
        <a
          href={`mailto:${CONTACT.email}`}
          class="text-meta text-on-deep-muted transition-colors hover:text-white">E-mail</a
        >
        <a
          href={CONTACT.linkedin}
          class="text-meta text-on-deep-muted transition-colors hover:text-white"
          rel="noopener"
          target="_blank">LinkedIn</a
        >
      </div>
    </div>

    <div
      class="flex flex-col gap-2 border-t border-line-deep py-6 text-xs text-on-deep-muted md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} {SITE.name}, CNPJ {CONTACT.cnpj}</p>
      <p>{SITE.domain}</p>
    </div>
  </div>
</footer>
