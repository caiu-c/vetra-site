---
import { NAV, SITE, CONTACT } from '@/config/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-rule bg-paper py-12">
  <div class="mx-auto flex max-w-container flex-col gap-8 px-6 md:px-16">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="font-serif text-2xl leading-none">V</span>
        <span class="font-serif text-[14px] tracking-wide">VETRA SOLUTIONS</span>
      </div>
      <p class="max-w-md font-sans text-sm text-muted">
        Engenharia de Dados e IA com rigor institucional. {SITE.city}.
      </p>
    </div>

    <nav
      class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted"
      aria-label="Navegação rodapé"
    >
      {
        NAV.map((item) => (
          <a href={item.href} class="hover:text-ink">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div
      class="flex flex-col gap-3 border-t border-rule pt-6 font-mono text-[10px] uppercase tracking-[0.18em] text-muted md:flex-row md:items-center md:justify-between"
    >
      <p>
        © {year} VETRA SOLUTIONS · CNPJ {CONTACT.cnpj} · FORTALEZA / CE
      </p>
      <div class="flex gap-4">
        <a href={CONTACT.linkedin} class="hover:text-ink" rel="noopener" target="_blank">
          LINKEDIN ↗
        </a>
        <a href={`mailto:${CONTACT.email}`} class="hover:text-ink">EMAIL ↗</a>
      </div>
    </div>
  </div>
</footer>
