---
import ApertureSymbol from './ApertureSymbol.astro';

const techs = [
  'PostgreSQL',
  'Snowflake',
  'dbt',
  'Airflow',
  'Python',
  'LangChain',
  'Streamlit',
  'Vercel',
  'Docker',
  'GitHub Actions',
] as const;
---

{/*
  Faixa de transição em Tinta logo após o hero (ritmo por blocos de cor, ADR-006).
  Marquee (src/scripts/motion/marquee.ts): a lista se repete duas vezes e anda -50%
  em loop. A primeira cópia é a lista acessível; a segunda é aria-hidden.
*/}
<section id="stack" class="overflow-hidden bg-ink text-white">
  <div class="wrap pt-8">
    {/* TODO: validar frase (nova do redesign, não aprovada) */}
    <p class="text-meta text-on-deep-muted">
      Construímos sobre a stack que sustenta operações de dados modernas
    </p>
  </div>

  <div class="py-8 md:py-10">
    <div class="flex w-max" data-marquee>
      {
        [0, 1].map((copy) => (
          <ul
            class="flex shrink-0"
            aria-hidden={copy === 1 ? 'true' : undefined}
            aria-label={copy === 0 ? 'Tecnologias' : undefined}
          >
            {techs.map((t) => (
              <li class="font-expanded flex items-center gap-6 pr-6 text-[clamp(24px,3vw,36px)] font-medium leading-none tracking-heading md:gap-10 md:pr-10">
                {t}
                <ApertureSymbol size={18} ariaLabel="" class="shrink-0 text-brand-light" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
