---
import { SITE } from '@/config/site';
---

{/* Sobre / manifesto: bloco editorial de duas colunas. Textos placeholder TODO até aprovação final. */}
<section id="sobre" class="bg-canvas">
  <div class="wrap">
    <div class="grid grid-cols-1 gap-6 py-24 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-16 md:py-32">
      <p class="text-meta text-muted">{SITE.name}, {SITE.city}</p>

      {/* TODO: validar texto definitivo do manifesto */}
      <p
        data-split
        class="font-expanded max-w-[30ch] text-[clamp(24px,2.8vw,36px)] font-medium leading-[1.2] tracking-heading text-ink"
      >
        Engenharia de dados não é commodity — é fundação. Por isso tratamos cada pipeline,
        modelo e agente como infraestrutura crítica: com arquitetura, testes e operação
        contínua.
      </p>
    </div>
  </div>
</section>
