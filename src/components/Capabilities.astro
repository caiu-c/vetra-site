---
import SectionLabel from './SectionLabel.astro';

const capabilities = [
  {
    n: '01',
    title: 'Bancos de dados',
    desc: 'Modelagem, ETL/ELT, infraestrutura confiável.',
  },
  {
    n: '02',
    title: 'Dashboards',
    desc: 'Camada analítica que vira decisão acionável.',
  },
  {
    n: '03',
    title: 'Agentes de IA',
    desc: 'Sistemas autônomos com guardrails e observabilidade.',
  },
  {
    n: '04',
    title: 'Automações',
    desc: 'RPA, orquestração, integração de sistemas.',
  },
] as const;
---

<section
  id="sistemas"
  data-reveal
  class="px-6 py-20 md:px-12"
>
  <SectionLabel number="02" name="CAPACIDADES" counterpart="04 / SISTEMAS" />

  <h2 class="text-balance mt-8 font-serif text-[38px] leading-tight text-ink">
    Quatro camadas. Um sistema.
  </h2>

  {/*
    Container dos 4 cards: borda externa 1px solid rule (rect 1004x220 do mockup) +
    divisores internos verticais entre os cards (em md:) ou horizontais (em mobile).
  */}
  <ul
    class="mt-12 grid grid-cols-1 divide-y divide-rule border border-rule md:grid-cols-4 md:divide-x md:divide-y-0"
  >
    {
      capabilities.map(({ n, title, desc }) => (
        <li class="group flex flex-col justify-between gap-12 px-0 py-8 transition-colors hover:bg-paper/40 md:px-6 md:py-10">
          <span class="font-mono text-[11px] uppercase tracking-[0.24em] text-accent transition-colors duration-200 group-hover:text-ink">
            {n}
          </span>
          <div class="flex flex-col gap-2">
            <h3 class="font-serif text-[20px] leading-tight text-ink">
              {title}
            </h3>
            <p class="font-sans text-[12px] leading-relaxed text-muted">
              {desc}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
