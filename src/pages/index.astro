---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FOUNDER } from '@/config/site';
import Hero from '@/components/Hero.astro';
import Diagnosis from '@/components/Diagnosis.astro';
import Capabilities from '@/components/Capabilities.astro';
import PhotoBand from '@/components/PhotoBand.astro';
import CostCalculator from '@/components/CostCalculator.astro';
import Indicators from '@/components/Indicators.astro';
import Sectors from '@/components/Sectors.astro';
import Cases from '@/components/Cases.astro';
import Manifesto from '@/components/Manifesto.astro';
import Founder from '@/components/Founder.astro';
import Faq from '@/components/Faq.astro';
import Contact from '@/components/Contact.astro';
---

{/* Ordem e fundos no ADR-010 (ritmo de cores do ADR-006): como começar logo depois do
    topo, a faixa de foto, serviços com as telas do que entregamos, prova, quem está por
    trás e contato. */}
<BaseLayout>
  <Hero />
  <Diagnosis />
  <PhotoBand />
  <CostCalculator />
  <Capabilities />
  <Indicators />
  <Sectors />
  <Cases />
  <Manifesto />
  {/* Quem conduz aparece quando FOUNDER.name está preenchido (auditoria A5). */}
  {FOUNDER.name && <Founder />}
  <Faq />
  <Contact />
</BaseLayout>
